# ---------------------------------------------------------------------------
# YantraSetu backend PRODUCTION environment template.
# Copy to `.env` on the production host (Render/Railway/VPS) and fill real
# values. NEVER commit the real file - `.env`/`*.env` are git-ignored.
#
# In production the app FAILS TO START if SECRET_KEY is a placeholder/too short,
# and DEBUG is forced off regardless of what is set here.
# ---------------------------------------------------------------------------

APP_ENV=production
DEBUG=false

# --- Database (managed PostgreSQL) ---
# On Render/Railway this is provided for you; paste the connection string and
# ensure it uses the psycopg2 driver prefix:
#   postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# URL-encode special characters in the password (@ : / # ? & -> %40 %3A ...).
DATABASE_URL=postgresql+psycopg2://PROD_USER:PROD_PASSWORD@PROD_HOST:5432/yantrasetu

# --- Security ---
# REQUIRED: generate a strong random value (>= 16 chars) or the app refuses to boot:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS: comma-separated list of allowed frontend origins ---
# Set to your deployed frontend URL(s). Do NOT use "*".
CORS_ORIGINS=https://your-frontend.netlify.app
