# ---------------------------------------------------------------------------
# YantraSetu backend environment template.
# Copy this file to `.env` (same folder) and adjust values.
# NEVER commit the real `.env` file - it is git-ignored on purpose.
# ---------------------------------------------------------------------------

APP_ENV=development
DEBUG=true

# --- Database ---
# Local development can use SQLite (zero setup). Production uses PostgreSQL.
# PostgreSQL example (uncomment and edit once your DB/user exist):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/yantrasetu
DATABASE_URL=sqlite:///./yantrasetu.db

# --- Security (used from the authentication phase) ---
# Generate a real random value for production, e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
