# ---------------------------------------------------------------------------
# YantraSetu backend environment template.
# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit the real `.env` file - it is git-ignored on purpose.
# ---------------------------------------------------------------------------

APP_ENV=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Format:
#   postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
#
# Example (user "postgres", db "yantrasetu" on the local server):
#   DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/yantrasetu
#
# If your password has special characters (@ : / # ? & etc.) URL-encode them,
# e.g. "p@ss:1" becomes "p%40ss%3A1".
DATABASE_URL=postgresql+psycopg2://YOUR_PG_USER:YOUR_PG_PASSWORD@localhost:5432/yantrasetu

# --- Security (used from the authentication phase) ---
# Generate a real random value for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS: comma-separated list of allowed frontend origins ---
# If unset, the app defaults to the Vite dev origins below.
# In production, set this to your deployed frontend origin(s), e.g.:
#   CORS_ORIGINS=https://yantrasetu.netlify.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
